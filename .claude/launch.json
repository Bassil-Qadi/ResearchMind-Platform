{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "dev-demo",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:demo"],
      "port": 3001
    },
    {
      "name": "start-demo",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start:demo", "--", "--port", "3002"],
      "port": 3002
    }
  ]
}
