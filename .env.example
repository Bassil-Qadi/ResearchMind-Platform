# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB (local: docker-compose up -d)
MONGODB_URI=mongodb://localhost:27017/research-platform

# NextAuth / Auth.js v5
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
# Legacy aliases (optional; AUTH_* preferred in v5)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Account seeded by `npm run seed` (development only — never used at sign-in)
DEV_USER_EMAIL=demo@university.edu
DEV_USER_PASSWORD=demo123456

# SAML / university SSO (configure when ready)
SAML_ENABLED=false
SAML_IDP_METADATA_URL=
SAML_CLIENT_ID=
SAML_CLIENT_SECRET=
SAML_ISSUER=

# OAuth providers (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Rate limiting — Upstash Redis (REST)
# Serverless hosting runs many short-lived instances, and without a shared store
# each one counts on its own, so the limits barely hold. Create a free database
# at upstash.com and copy the REST URL and REST token (not the rediss:// URL).
# Unset, the limiter counts in-process, which is fine for a single local server.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# File storage — Cloudinary (avatars and project files)
# Copy the "API environment variable" straight from the Cloudinary dashboard:
#   cloudinary://<api_key>:<api_secret>@<cloud_name>
# The cloud name is the part after "@" — it is NOT the product environment's
# display name, which is a different string.
CLOUDINARY_URL=

# Or set the three separately instead of CLOUDINARY_URL:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email — Resend (registration, approvals, invitations, join requests)
RESEND_API_KEY=
# Must be an address on a domain verified in Resend. researchmind.live is
# verified (DNS records live in Netlify DNS, which hosts the zone). Resend's
# shared onboarding@resend.dev only ever delivers to your own account address.
EMAIL_FROM="ResearchMind <noreply@researchmind.live>"

# Real-time updates — Pusher Channels (chat, task board, comments, DMs, notifications)
# Create a Channels app at pusher.com and copy these from its App Keys page.
# In the app's settings, turn on "Enable client events": the typing indicator is
# sent browser-to-browser. Without these keys the app still works, just not live.
PUSHER_APP_ID=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=
